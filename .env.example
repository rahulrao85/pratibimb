# Pratibimb environment configuration. Copy to .env; never commit real values.

# --- Gemini on Vertex AI (recommended: billed to the Cloud project) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Local dev without an ADC file: the gcloud CLI token of this account is used instead.
# GCLOUD_ACCOUNT=you@example.com

# --- Or: Gemini API key from AI Studio (set GOOGLE_GENAI_USE_VERTEXAI=false) ---
# GEMINI_API_KEY=

# --- Engine ---
# off = deterministic mandate rules only (the back-test baseline)
PRATIBIMB_LLM=on
# Live Gemini calls allowed per day before falling back to rules (protects a public demo)
LLM_DAILY_CALL_CAP=300
# Allow POST /api/backtest/run (costs Gemini calls)
ALLOW_BACKTEST_RUN=false
# Extra origins allowed to call the API (the Vite dev server); production serves UI and API on one origin
CORS_ORIGINS=http://localhost:5173
